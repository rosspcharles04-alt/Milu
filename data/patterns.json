[{"id":"p_name","hanzi":"我叫 ___。","pinyin":"Wǒ jiào ___.","english":"My name is ___.","lesson":"10.16","note":"叫 (jiào) literally means 'to be called'. No verb 'to be' needed.","examples":[{"hanzi":"我叫李明。","pinyin":"Wǒ jiào Lǐ Míng.","english":"My name is Li Ming.","units":[{"c":"我","p":"Wǒ","t":3},{"c":"叫","p":"jiào","t":4},{"c":"李","p":"Lǐ","t":3},{"c":"明","p":"Míng","t":2}],"words":["我","叫","李","明"]},{"hanzi":"你叫什么名字？","pinyin":"Nǐ jiào shénme míngzi?","english":"What's your name?","units":[{"c":"你","p":"Nǐ","t":3},{"c":"叫","p":"jiào","t":4},{"c":"什","p":"shén","t":2},{"c":"么","p":"me","t":5},{"c":"名","p":"míng","t":2},{"c":"字","p":"zi","t":5}],"words":["你","叫","什么","名字"]}]},{"id":"p_shi","hanzi":"我是 ___。","pinyin":"Wǒ shì ___.","english":"I am ___.","lesson":"10.16","note":"是 (shì) links two nouns. Use it for nationality and jobs — but NOT before adjectives.","examples":[{"hanzi":"我是澳大利亚人。","pinyin":"Wǒ shì Àodàlìyàrén.","english":"I am Australian.","units":[{"c":"我","p":"Wǒ","t":3},{"c":"是","p":"shì","t":4},{"c":"澳","p":"Ào","t":4},{"c":"大","p":"dà","t":4},{"c":"利","p":"lì","t":4},{"c":"亚","p":"yà","t":4},{"c":"人","p":"rén","t":2}],"words":["我","是","澳大利亚","人"]},{"hanzi":"她是老师。","pinyin":"Tā shì lǎoshī.","english":"She is a teacher.","units":[{"c":"她","p":"Tā","t":1},{"c":"是","p":"shì","t":4},{"c":"老","p":"lǎo","t":3},{"c":"师","p":"shī","t":1}],"words":["她","是","老师"]}]},{"id":"p_hen","hanzi":"我很 ___。","pinyin":"Wǒ hěn ___.","english":"I am (feeling) ___.","lesson":"3.10","note":"With adjectives you drop 是 and use 很 instead. 我很累 — never 我是累.","examples":[{"hanzi":"我很开心。","pinyin":"Wǒ hěn kāixīn.","english":"I am happy.","units":[{"c":"我","p":"Wǒ","t":3},{"c":"很","p":"hěn","t":3},{"c":"开","p":"kāi","t":1},{"c":"心","p":"xīn","t":1}],"words":["我","很","开心"]},{"hanzi":"我很累。","pinyin":"Wǒ hěn lèi.","english":"I am tired.","units":[{"c":"我","p":"Wǒ","t":3},{"c":"很","p":"hěn","t":3},{"c":"累","p":"lèi","t":4}],"words":["我","很","累"]},{"hanzi":"他很紧张。","pinyin":"Tā hěn jǐnzhāng.","english":"He is nervous.","units":[{"c":"他","p":"Tā","t":1},{"c":"很","p":"hěn","t":3},{"c":"紧","p":"jǐn","t":3},{"c":"张","p":"zhāng","t":1}],"words":["他","很","紧张"]}]},{"id":"p_like","hanzi":"我喜欢 ___。","pinyin":"Wǒ xǐhuan ___.","english":"I like ___.","lesson":"3.3","note":"喜欢 can be followed by a noun or another verb.","examples":[{"hanzi":"我喜欢熊猫。","pinyin":"Wǒ xǐhuan xióngmāo.","english":"I like pandas.","units":[{"c":"我","p":"Wǒ","t":3},{"c":"喜","p":"xǐ","t":3},{"c":"欢","p":"huan","t":5},{"c":"熊","p":"xióng","t":2},{"c":"猫","p":"māo","t":1}],"words":["我","喜欢","熊猫"]},{"hanzi":"我喜欢看电影。","pinyin":"Wǒ xǐhuan kàn diànyǐng.","english":"I like watching films.","units":[{"c":"我","p":"Wǒ","t":3},{"c":"喜","p":"xǐ","t":3},{"c":"欢","p":"huan","t":5},{"c":"看","p":"kàn","t":4},{"c":"电","p":"diàn","t":4},{"c":"影","p":"yǐng","t":3}],"words":["我","喜欢","看电影"]}]},{"id":"p_likeeat","hanzi":"我喜欢吃 ___。","pinyin":"Wǒ xǐhuan chī ___.","english":"I like eating ___.","lesson":"3.3","note":"Chinese keeps the verb 吃 even where English would drop it.","examples":[{"hanzi":"我喜欢吃火锅。","pinyin":"Wǒ xǐhuan chī huǒguō.","english":"I like eating hot pot.","units":[{"c":"我","p":"Wǒ","t":3},{"c":"喜","p":"xǐ","t":3},{"c":"欢","p":"huan","t":5},{"c":"吃","p":"chī","t":1},{"c":"火","p":"huǒ","t":3},{"c":"锅","p":"guō","t":1}],"words":["我","喜欢","吃","火锅"]},{"hanzi":"我喜欢吃饺子。","pinyin":"Wǒ xǐhuan chī jiǎozi.","english":"I like eating dumplings.","units":[{"c":"我","p":"Wǒ","t":3},{"c":"喜","p":"xǐ","t":3},{"c":"欢","p":"huan","t":5},{"c":"吃","p":"chī","t":1},{"c":"饺","p":"jiǎo","t":3},{"c":"子","p":"zi","t":5}],"words":["我","喜欢","吃","饺子"]}]},{"id":"p_want","hanzi":"我想要 ___。","pinyin":"Wǒ xiǎng yào ___.","english":"I would like ___.","lesson":"1.27","note":"想要 is softer and more polite than plain 要 when ordering.","examples":[{"hanzi":"我想要一个冰淇淋。","pinyin":"Wǒ xiǎng yào yí gè bīngqílín.","english":"I'd like an ice cream.","units":[{"c":"我","p":"Wǒ","t":3},{"c":"想","p":"xiǎng","t":3},{"c":"要","p":"yào","t":4},{"c":"一","p":"yí","t":2},{"c":"个","p":"gè","t":4},{"c":"冰","p":"bīng","t":1},{"c":"淇","p":"qí","t":2},{"c":"淋","p":"lín","t":2}],"words":["我","想要","一","个","冰淇淋"]},{"hanzi":"我还想要一碗米饭。","pinyin":"Wǒ hái xiǎng yào yì wǎn mǐfàn.","english":"I'd also like a bowl of rice.","units":[{"c":"我","p":"Wǒ","t":3},{"c":"还","p":"hái","t":2},{"c":"想","p":"xiǎng","t":3},{"c":"要","p":"yào","t":4},{"c":"一","p":"yì","t":4},{"c":"碗","p":"wǎn","t":3},{"c":"米","p":"mǐ","t":3},{"c":"饭","p":"fàn","t":4}],"words":["我","还","想要","一","碗","米饭"]}]},{"id":"p_wear","hanzi":"我穿 ___。","pinyin":"Wǒ chuān ___.","english":"I'm wearing ___.","lesson":"clothes","note":"穿 for things you put your limbs through; 戴 for hats, glasses, watches and jewellery.","examples":[{"hanzi":"我穿牛仔裤。","pinyin":"Wǒ chuān niúzǎikù.","english":"I'm wearing jeans.","units":[{"c":"我","p":"Wǒ","t":3},{"c":"穿","p":"chuān","t":1},{"c":"牛","p":"niú","t":2},{"c":"仔","p":"zǎi","t":3},{"c":"裤","p":"kù","t":4}],"words":["我","穿","牛仔裤"]},{"hanzi":"我戴帽子。","pinyin":"Wǒ dài màozi.","english":"I'm wearing a hat.","units":[{"c":"我","p":"Wǒ","t":3},{"c":"戴","p":"dài","t":4},{"c":"帽","p":"mào","t":4},{"c":"子","p":"zi","t":5}],"words":["我","戴","帽子"]}]},{"id":"p_go","hanzi":"我要去 ___。","pinyin":"Wǒ yào qù ___.","english":"I want to go to ___.","lesson":"transport","note":"要 + verb expresses intention — 'I'm going to…'.","examples":[{"hanzi":"我要去市中心。","pinyin":"Wǒ yào qù shìzhōngxīn.","english":"I want to go to the city centre.","units":[{"c":"我","p":"Wǒ","t":3},{"c":"要","p":"yào","t":4},{"c":"去","p":"qù","t":4},{"c":"市","p":"shì","t":4},{"c":"中","p":"zhōng","t":1},{"c":"心","p":"xīn","t":1}],"words":["我","要","去","市中心"]},{"hanzi":"我要去火车站。","pinyin":"Wǒ yào qù huǒchēzhàn.","english":"I want to go to the train station.","units":[{"c":"我","p":"Wǒ","t":3},{"c":"要","p":"yào","t":4},{"c":"去","p":"qù","t":4},{"c":"火","p":"huǒ","t":3},{"c":"车","p":"chē","t":1},{"c":"站","p":"zhàn","t":4}],"words":["我","要","去","火车站"]}]},{"id":"p_where","hanzi":"___ 在哪儿？","pinyin":"___ zài nǎr?","english":"Where is ___?","lesson":"transport","note":"在 marks location. 哪儿 is 'where' in northern speech; 哪里 is the southern equivalent.","examples":[{"hanzi":"火车站在哪儿？","pinyin":"Huǒchēzhàn zài nǎr?","english":"Where is the train station?","units":[{"c":"火","p":"Huǒ","t":3},{"c":"车","p":"chē","t":1},{"c":"站","p":"zhàn","t":4},{"c":"在","p":"zài","t":4},{"c":"哪","p":"nǎ","t":3},{"c":"儿","p":"r","t":5}],"words":["火车站","在","哪儿"]},{"hanzi":"洗手间在哪儿？","pinyin":"Xǐshǒujiān zài nǎr?","english":"Where is the toilet?","units":[{"c":"洗","p":"Xǐ","t":3},{"c":"手","p":"shǒu","t":3},{"c":"间","p":"jiān","t":1},{"c":"在","p":"zài","t":4},{"c":"哪","p":"nǎ","t":3},{"c":"儿","p":"r","t":5}],"words":["洗","手","间","在","哪儿"]}]},{"id":"p_time","hanzi":"现在 ___ 点。","pinyin":"Xiànzài ___ diǎn.","english":"It is ___ o'clock.","lesson":"5.26","note":"Chinese time runs BIG to SMALL: day → part of day → hour → minute.","examples":[{"hanzi":"现在三点半。","pinyin":"Xiànzài sān diǎn bàn.","english":"It's half past three.","units":[{"c":"现","p":"Xiàn","t":4},{"c":"在","p":"zài","t":4},{"c":"三","p":"sān","t":1},{"c":"点","p":"diǎn","t":3},{"c":"半","p":"bàn","t":4}],"words":["现在","三","点","半"]},{"hanzi":"现在九点一刻。","pinyin":"Xiànzài jiǔ diǎn yí kè.","english":"It's a quarter past nine.","units":[{"c":"现","p":"Xiàn","t":4},{"c":"在","p":"zài","t":4},{"c":"九","p":"jiǔ","t":3},{"c":"点","p":"diǎn","t":3},{"c":"一","p":"yí","t":2},{"c":"刻","p":"kè","t":4}],"words":["现在","九","点","一","刻"]},{"hanzi":"星期一下午五点。","pinyin":"Xīngqīyī xiàwǔ wǔ diǎn.","english":"5pm on Monday.","units":[{"c":"星","p":"Xīng","t":1},{"c":"期","p":"qī","t":1},{"c":"一","p":"yī","t":1},{"c":"下","p":"xià","t":4},{"c":"午","p":"wǔ","t":3},{"c":"五","p":"wǔ","t":3},{"c":"点","p":"diǎn","t":3}],"words":["星期一","下午","五","点"]}]},{"id":"p_ma","hanzi":"___ 吗？","pinyin":"___ ma?","english":"(yes/no question)","lesson":"10.16","note":"Add 吗 to the end of any statement to turn it into a yes/no question.","examples":[{"hanzi":"你是学生吗？","pinyin":"Nǐ shì xuéshēng ma?","english":"Are you a student?","units":[{"c":"你","p":"Nǐ","t":3},{"c":"是","p":"shì","t":4},{"c":"学","p":"xué","t":2},{"c":"生","p":"shēng","t":1},{"c":"吗","p":"ma","t":5}],"words":["你","是","学生","吗"]},{"hanzi":"你戴帽子吗？","pinyin":"Nǐ dài màozi ma?","english":"Are you wearing a hat?","units":[{"c":"你","p":"Nǐ","t":3},{"c":"戴","p":"dài","t":4},{"c":"帽","p":"mào","t":4},{"c":"子","p":"zi","t":5},{"c":"吗","p":"ma","t":5}],"words":["你","戴","帽子","吗"]}]},{"id":"p_haishi","hanzi":"A 还是 B？","pinyin":"A háishi B?","english":"A or B?","lesson":"11.6","note":"还是 offers a choice in a question. Use 或者 for 'or' in a statement.","examples":[{"hanzi":"你要奶茶还是橙汁？","pinyin":"Nǐ yào nǎichá háishi chéngzhī?","english":"Milk tea or orange juice?","units":[{"c":"你","p":"Nǐ","t":3},{"c":"要","p":"yào","t":4},{"c":"奶","p":"nǎi","t":3},{"c":"茶","p":"chá","t":2},{"c":"还","p":"hái","t":2},{"c":"是","p":"shi","t":5},{"c":"橙","p":"chéng","t":2},{"c":"汁","p":"zhī","t":1}],"words":["你","要","奶茶","还","是","橙汁"]},{"hanzi":"冰的还是热的？","pinyin":"Bīng de háishi rè de?","english":"Iced or hot?","units":[{"c":"冰","p":"Bīng","t":1},{"c":"的","p":"de","t":5},{"c":"还","p":"hái","t":2},{"c":"是","p":"shi","t":5},{"c":"热","p":"rè","t":4},{"c":"的","p":"de","t":5}],"words":["冰","的","还","是","热","的"]}]}]