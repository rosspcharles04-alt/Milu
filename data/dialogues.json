[{"id":"d_clothes","title":"What are you wearing today?","emoji":"👕","lesson":"clothes","lines":[{"speaker":"A","hanzi":"你今天穿什么？","pinyin":"Nǐ jīntiān chuān shénme?","english":"What are you wearing today?","units":[{"c":"你","p":"Nǐ","t":3},{"c":"今","p":"jīn","t":1},{"c":"天","p":"tiān","t":1},{"c":"穿","p":"chuān","t":1},{"c":"什","p":"shén","t":2},{"c":"么","p":"me","t":5}]},{"speaker":"B","hanzi":"我穿T恤和牛仔裤。","pinyin":"Wǒ chuān T xù hé niúzǎikù.","english":"I'm wearing a T-shirt and jeans.","units":[{"c":"我","p":"Wǒ","t":3},{"c":"穿","p":"chuān","t":1},{"c":"T","p":"T","t":5},{"c":"恤","p":"xù","t":4},{"c":"和","p":"hé","t":2},{"c":"牛","p":"niú","t":2},{"c":"仔","p":"zǎi","t":3},{"c":"裤","p":"kù","t":4}]},{"speaker":"A","hanzi":"你戴帽子吗？","pinyin":"Nǐ dài màozi ma?","english":"Are you wearing a hat?","units":[{"c":"你","p":"Nǐ","t":3},{"c":"戴","p":"dài","t":4},{"c":"帽","p":"mào","t":4},{"c":"子","p":"zi","t":5},{"c":"吗","p":"ma","t":5}]},{"speaker":"B","hanzi":"对，我戴帽子！","pinyin":"Duì, wǒ dài màozi!","english":"Yes, I'm wearing a hat!","units":[{"c":"对","p":"Duì","t":4},{"c":"我","p":"wǒ","t":3},{"c":"戴","p":"dài","t":4},{"c":"帽","p":"mào","t":4},{"c":"子","p":"zi","t":5}]}]},{"id":"d_feelings","title":"How do you feel today?","emoji":"😊","lesson":"3.10","lines":[{"speaker":"A","hanzi":"你今天感觉怎么样？","pinyin":"Nǐ jīntiān gǎnjué zěnmeyàng?","english":"How do you feel today?","units":[{"c":"你","p":"Nǐ","t":3},{"c":"今","p":"jīn","t":1},{"c":"天","p":"tiān","t":1},{"c":"感","p":"gǎn","t":3},{"c":"觉","p":"jué","t":2},{"c":"怎","p":"zěn","t":3},{"c":"么","p":"me","t":5},{"c":"样","p":"yàng","t":4}]},{"speaker":"B","hanzi":"我很开心！","pinyin":"Wǒ hěn kāixīn!","english":"I feel happy!","units":[{"c":"我","p":"Wǒ","t":3},{"c":"很","p":"hěn","t":3},{"c":"开","p":"kāi","t":1},{"c":"心","p":"xīn","t":1}]},{"speaker":"A","hanzi":"为什么？","pinyin":"Wèishénme?","english":"Why?","units":[{"c":"为","p":"Wèi","t":4},{"c":"什","p":"shén","t":2},{"c":"么","p":"me","t":5}]},{"speaker":"B","hanzi":"因为今天是我的生日。","pinyin":"Yīnwèi jīntiān shì wǒ de shēngrì.","english":"Because today is my birthday.","units":[{"c":"因","p":"Yīn","t":1},{"c":"为","p":"wèi","t":4},{"c":"今","p":"jīn","t":1},{"c":"天","p":"tiān","t":1},{"c":"是","p":"shì","t":4},{"c":"我","p":"wǒ","t":3},{"c":"的","p":"de","t":5},{"c":"生","p":"shēng","t":1},{"c":"日","p":"rì","t":4}]}]},{"id":"d_icecream","title":"Ordering an ice cream","emoji":"🍦","lesson":"1.27","lines":[{"speaker":"A","hanzi":"你好！你要什么口味的冰淇淋？","pinyin":"Nǐ hǎo! Nǐ yào shénme kǒuwèi de bīngqílín?","english":"Hello! What flavour ice cream would you like?","units":[{"c":"你","p":"Nǐ","t":3},{"c":"好","p":"hǎo","t":3},{"c":"你","p":"Nǐ","t":3},{"c":"要","p":"yào","t":4},{"c":"什","p":"shén","t":2},{"c":"么","p":"me","t":5},{"c":"口","p":"kǒu","t":3},{"c":"味","p":"wèi","t":4},{"c":"的","p":"de","t":5},{"c":"冰","p":"bīng","t":1},{"c":"淇","p":"qí","t":2},{"c":"淋","p":"lín","t":2}]},{"speaker":"B","hanzi":"我要一个芒果冰淇淋。","pinyin":"Wǒ yào yí gè mángguǒ bīngqílín.","english":"I'd like a mango ice cream.","units":[{"c":"我","p":"Wǒ","t":3},{"c":"要","p":"yào","t":4},{"c":"一","p":"yí","t":2},{"c":"个","p":"gè","t":4},{"c":"芒","p":"máng","t":2},{"c":"果","p":"guǒ","t":3},{"c":"冰","p":"bīng","t":1},{"c":"淇","p":"qí","t":2},{"c":"淋","p":"lín","t":2}]},{"speaker":"A","hanzi":"好的，五块钱。","pinyin":"Hǎo de, wǔ kuài qián.","english":"Okay, five yuan.","units":[{"c":"好","p":"Hǎo","t":3},{"c":"的","p":"de","t":5},{"c":"五","p":"wǔ","t":3},{"c":"块","p":"kuài","t":4},{"c":"钱","p":"qián","t":2}]},{"speaker":"B","hanzi":"谢谢！","pinyin":"Xièxie!","english":"Thank you!","units":[{"c":"谢","p":"Xiè","t":4},{"c":"谢","p":"xie","t":5}]}]},{"id":"d_restaurant","title":"Ordering in a restaurant","emoji":"🍜","lesson":"11.6","lines":[{"speaker":"A","hanzi":"你们想吃什么？","pinyin":"Nǐmen xiǎng chī shénme?","english":"What would you like to eat?","units":[{"c":"你","p":"Nǐ","t":3},{"c":"们","p":"men","t":5},{"c":"想","p":"xiǎng","t":3},{"c":"吃","p":"chī","t":1},{"c":"什","p":"shén","t":2},{"c":"么","p":"me","t":5}]},{"speaker":"B","hanzi":"来一个鱼香肉丝。","pinyin":"Lái yí gè yúxiāng ròusī.","english":"We'll have the shredded pork in garlic sauce.","units":[{"c":"来","p":"Lái","t":2},{"c":"一","p":"yí","t":2},{"c":"个","p":"gè","t":4},{"c":"鱼","p":"yú","t":2},{"c":"香","p":"xiāng","t":1},{"c":"肉","p":"ròu","t":4},{"c":"丝","p":"sī","t":1}]},{"speaker":"A","hanzi":"主食要什么？","pinyin":"Zhǔshí yào shénme?","english":"What would you like for your staple?","units":[{"c":"主","p":"Zhǔ","t":3},{"c":"食","p":"shí","t":2},{"c":"要","p":"yào","t":4},{"c":"什","p":"shén","t":2},{"c":"么","p":"me","t":5}]},{"speaker":"B","hanzi":"请来一碗米饭。","pinyin":"Qǐng lái yì wǎn mǐfàn.","english":"A bowl of rice, please.","units":[{"c":"请","p":"Qǐng","t":3},{"c":"来","p":"lái","t":2},{"c":"一","p":"yì","t":4},{"c":"碗","p":"wǎn","t":3},{"c":"米","p":"mǐ","t":3},{"c":"饭","p":"fàn","t":4}]},{"speaker":"A","hanzi":"喝点什么？","pinyin":"Hē diǎn shénme?","english":"What would you like to drink?","units":[{"c":"喝","p":"Hē","t":1},{"c":"点","p":"diǎn","t":3},{"c":"什","p":"shén","t":2},{"c":"么","p":"me","t":5}]},{"speaker":"B","hanzi":"来一瓶啤酒。","pinyin":"Lái yì píng píjiǔ.","english":"A bottle of beer, please.","units":[{"c":"来","p":"Lái","t":2},{"c":"一","p":"yì","t":4},{"c":"瓶","p":"píng","t":2},{"c":"啤","p":"pí","t":2},{"c":"酒","p":"jiǔ","t":3}]}]},{"id":"d_drinks","title":"Milk tea or orange juice?","emoji":"🧋","lesson":"11.6","lines":[{"speaker":"A","hanzi":"你要奶茶还是橙汁？","pinyin":"Nǐ yào nǎichá háishi chéngzhī?","english":"Would you like milk tea or orange juice?","units":[{"c":"你","p":"Nǐ","t":3},{"c":"要","p":"yào","t":4},{"c":"奶","p":"nǎi","t":3},{"c":"茶","p":"chá","t":2},{"c":"还","p":"hái","t":2},{"c":"是","p":"shi","t":5},{"c":"橙","p":"chéng","t":2},{"c":"汁","p":"zhī","t":1}]},{"speaker":"B","hanzi":"我要奶茶。","pinyin":"Wǒ yào nǎichá.","english":"I'd like milk tea.","units":[{"c":"我","p":"Wǒ","t":3},{"c":"要","p":"yào","t":4},{"c":"奶","p":"nǎi","t":3},{"c":"茶","p":"chá","t":2}]},{"speaker":"A","hanzi":"冰的还是热的？","pinyin":"Bīng de háishi rè de?","english":"Iced or hot?","units":[{"c":"冰","p":"Bīng","t":1},{"c":"的","p":"de","t":5},{"c":"还","p":"hái","t":2},{"c":"是","p":"shi","t":5},{"c":"热","p":"rè","t":4},{"c":"的","p":"de","t":5}]},{"speaker":"B","hanzi":"热的，谢谢。","pinyin":"Rè de, xièxie.","english":"Hot please.","units":[{"c":"热","p":"Rè","t":4},{"c":"的","p":"de","t":5},{"c":"谢","p":"xiè","t":4},{"c":"谢","p":"xie","t":5}]},{"speaker":"A","hanzi":"主食呢？米饭还是面条？","pinyin":"Zhǔshí ne? Mǐfàn háishi miàntiáo?","english":"And the staple? Rice or noodles?","units":[{"c":"主","p":"Zhǔ","t":3},{"c":"食","p":"shí","t":2},{"c":"呢","p":"ne","t":5},{"c":"米","p":"Mǐ","t":3},{"c":"饭","p":"fàn","t":4},{"c":"还","p":"hái","t":2},{"c":"是","p":"shi","t":5},{"c":"面","p":"miàn","t":4},{"c":"条","p":"tiáo","t":2}]},{"speaker":"B","hanzi":"我想要包子，可以吗？","pinyin":"Wǒ xiǎng yào bāozi, kěyǐ ma?","english":"I'd like steamed buns, is that okay?","units":[{"c":"我","p":"Wǒ","t":3},{"c":"想","p":"xiǎng","t":3},{"c":"要","p":"yào","t":4},{"c":"包","p":"bāo","t":1},{"c":"子","p":"zi","t":5},{"c":"可","p":"kě","t":3},{"c":"以","p":"yǐ","t":3},{"c":"吗","p":"ma","t":5}]},{"speaker":"A","hanzi":"可以！","pinyin":"Kěyǐ!","english":"Sure!","units":[{"c":"可","p":"Kě","t":3},{"c":"以","p":"yǐ","t":3}]}]},{"id":"d_takeaway","title":"Asking to take it away","emoji":"🥡","lesson":"11.6","lines":[{"speaker":"A","hanzi":"服务员，我要打包。","pinyin":"Fúwùyuán, wǒ yào dǎbāo.","english":"Waiter, I'd like to take this away.","units":[{"c":"服","p":"Fú","t":2},{"c":"务","p":"wù","t":4},{"c":"员","p":"yuán","t":2},{"c":"我","p":"wǒ","t":3},{"c":"要","p":"yào","t":4},{"c":"打","p":"dǎ","t":3},{"c":"包","p":"bāo","t":1}]},{"speaker":"B","hanzi":"打包这个菜还是那个？","pinyin":"Dǎbāo zhège cài háishi nàge?","english":"Pack this dish or that one?","units":[{"c":"打","p":"Dǎ","t":3},{"c":"包","p":"bāo","t":1},{"c":"这","p":"zhè","t":4},{"c":"个","p":"ge","t":5},{"c":"菜","p":"cài","t":4},{"c":"还","p":"hái","t":2},{"c":"是","p":"shi","t":5},{"c":"那","p":"nà","t":4},{"c":"个","p":"ge","t":5}]},{"speaker":"A","hanzi":"两个都打包，谢谢。","pinyin":"Liǎng gè dōu dǎbāo, xièxie.","english":"Both, please.","units":[{"c":"两","p":"Liǎng","t":3},{"c":"个","p":"gè","t":4},{"c":"都","p":"dōu","t":1},{"c":"打","p":"dǎ","t":3},{"c":"包","p":"bāo","t":1},{"c":"谢","p":"xiè","t":4},{"c":"谢","p":"xie","t":5}]}]},{"id":"d_uber","title":"Taking an Uber","emoji":"🚗","lesson":"transport","lines":[{"speaker":"A","hanzi":"你好！去悉尼大学。","pinyin":"Nǐ hǎo! Qù Xīní Dàxué.","english":"Hi! To the University of Sydney, please.","units":[{"c":"你","p":"Nǐ","t":3},{"c":"好","p":"hǎo","t":3},{"c":"去","p":"Qù","t":4},{"c":"悉","p":"Xīn","t":1},{"c":"尼","p":"í","t":2},{"c":"大","p":"Dà","t":4},{"c":"学","p":"xué","t":2}]},{"speaker":"B","hanzi":"好的，请系好安全带。","pinyin":"Hǎo de, qǐng jì hǎo ānquándài.","english":"Sure — please buckle up.","units":[{"c":"好","p":"Hǎo","t":3},{"c":"的","p":"de","t":5},{"c":"请","p":"qǐng","t":3},{"c":"系","p":"jì","t":4},{"c":"好","p":"hǎo","t":3},{"c":"安","p":"ān","t":1},{"c":"全","p":"quán","t":2},{"c":"带","p":"dài","t":4}]},{"speaker":"A","hanzi":"现在堵车吗？","pinyin":"Xiànzài dǔchē ma?","english":"Is there much traffic right now?","units":[{"c":"现","p":"Xiàn","t":4},{"c":"在","p":"zài","t":4},{"c":"堵","p":"dǔ","t":3},{"c":"车","p":"chē","t":1},{"c":"吗","p":"ma","t":5}]},{"speaker":"B","hanzi":"有一点儿，大概二十分钟。","pinyin":"Yǒu yìdiǎnr, dàgài èrshí fēnzhōng.","english":"A little — about twenty minutes.","units":[{"c":"有","p":"","t":0},{"c":"一","p":"","t":0},{"c":"点","p":"","t":0},{"c":"儿","p":"","t":0},{"c":"大","p":"","t":0},{"c":"概","p":"","t":0},{"c":"二","p":"","t":0},{"c":"十","p":"","t":0},{"c":"分","p":"","t":0},{"c":"钟","p":"","t":0}]},{"speaker":"A","hanzi":"好，在前面停就行，谢谢！","pinyin":"Hǎo, zài qiánmiàn tíng jiù xíng, xièxie!","english":"OK, just stop up ahead. Thanks!","units":[{"c":"好","p":"Hǎo","t":3},{"c":"在","p":"zài","t":4},{"c":"前","p":"qián","t":2},{"c":"面","p":"miàn","t":4},{"c":"停","p":"tíng","t":2},{"c":"就","p":"jiù","t":4},{"c":"行","p":"xíng","t":2},{"c":"谢","p":"xiè","t":4},{"c":"谢","p":"xie","t":5}]}]},{"id":"d_train","title":"At the train station","emoji":"🚉","lesson":"transport","lines":[{"speaker":"A","hanzi":"请问，火车站在哪儿？","pinyin":"Qǐngwèn, huǒchēzhàn zài nǎr?","english":"Excuse me, where is the train station?","units":[{"c":"请","p":"Qǐng","t":3},{"c":"问","p":"wèn","t":4},{"c":"火","p":"huǒ","t":3},{"c":"车","p":"chē","t":1},{"c":"站","p":"zhàn","t":4},{"c":"在","p":"zài","t":4},{"c":"哪","p":"nǎ","t":3},{"c":"儿","p":"r","t":5}]},{"speaker":"B","hanzi":"在前面，走路五分钟。","pinyin":"Zài qiánmiàn, zǒulù wǔ fēnzhōng.","english":"Just ahead, five minutes' walk.","units":[{"c":"在","p":"Zài","t":4},{"c":"前","p":"qián","t":2},{"c":"面","p":"miàn","t":4},{"c":"走","p":"zǒu","t":3},{"c":"路","p":"lù","t":4},{"c":"五","p":"wǔ","t":3},{"c":"分","p":"fēn","t":1},{"c":"钟","p":"zhōng","t":1}]},{"speaker":"A","hanzi":"我要充值交通卡。","pinyin":"Wǒ yào chōngzhí jiāotōngkǎ.","english":"I'd like to top up my transport card.","units":[{"c":"我","p":"Wǒ","t":3},{"c":"要","p":"yào","t":4},{"c":"充","p":"chōng","t":1},{"c":"值","p":"zhí","t":2},{"c":"交","p":"jiāo","t":1},{"c":"通","p":"tōng","t":1},{"c":"卡","p":"kǎ","t":3}]},{"speaker":"B","hanzi":"好的。上车刷卡，下车也要刷卡。","pinyin":"Hǎo de. Shàngchē shuākǎ, xiàchē yě yào shuākǎ.","english":"Okay. Tap on when you board, and tap off when you get off.","units":[{"c":"好","p":"Hǎo","t":3},{"c":"的","p":"de","t":5},{"c":"上","p":"Shàng","t":4},{"c":"车","p":"chē","t":1},{"c":"刷","p":"shuā","t":1},{"c":"卡","p":"kǎ","t":3},{"c":"下","p":"xià","t":4},{"c":"车","p":"chē","t":1},{"c":"也","p":"yě","t":3},{"c":"要","p":"yào","t":4},{"c":"刷","p":"shuā","t":1},{"c":"卡","p":"kǎ","t":3}]},{"speaker":"A","hanzi":"这趟车去邦代海滩吗？","pinyin":"Zhè tàng chē qù Bāngdài hǎitān ma?","english":"Does this train go to Bondi Beach?","units":[{"c":"这","p":"Zhè","t":4},{"c":"趟","p":"tàng","t":4},{"c":"车","p":"chē","t":1},{"c":"去","p":"qù","t":4},{"c":"邦","p":"Bāng","t":1},{"c":"代","p":"dài","t":4},{"c":"海","p":"hǎi","t":3},{"c":"滩","p":"tān","t":1},{"c":"吗","p":"ma","t":5}]},{"speaker":"B","hanzi":"去，大概半个小时。","pinyin":"Qù, dàgài bàn gè xiǎoshí.","english":"Yes, about half an hour.","units":[{"c":"去","p":"Qù","t":4},{"c":"大","p":"dà","t":4},{"c":"概","p":"gài","t":4},{"c":"半","p":"bàn","t":4},{"c":"个","p":"gè","t":4},{"c":"小","p":"xiǎo","t":3},{"c":"时","p":"shí","t":2}]}]},{"id":"d_time","title":"What time is it?","emoji":"🕐","lesson":"5.26","lines":[{"speaker":"A","hanzi":"现在几点？","pinyin":"Xiànzài jǐ diǎn?","english":"What time is it now?","units":[{"c":"现","p":"Xiàn","t":4},{"c":"在","p":"zài","t":4},{"c":"几","p":"jǐ","t":3},{"c":"点","p":"diǎn","t":3}]},{"speaker":"B","hanzi":"现在早上八点半。","pinyin":"Xiànzài zǎoshang bā diǎn bàn.","english":"It's 8:30 in the morning.","units":[{"c":"现","p":"Xiàn","t":4},{"c":"在","p":"zài","t":4},{"c":"早","p":"zǎo","t":3},{"c":"上","p":"shang","t":5},{"c":"八","p":"bā","t":1},{"c":"点","p":"diǎn","t":3},{"c":"半","p":"bàn","t":4}]},{"speaker":"A","hanzi":"你几点吃饭？","pinyin":"Nǐ jǐ diǎn chīfàn?","english":"What time do you eat?","units":[{"c":"你","p":"Nǐ","t":3},{"c":"几","p":"jǐ","t":3},{"c":"点","p":"diǎn","t":3},{"c":"吃","p":"chī","t":1},{"c":"饭","p":"fàn","t":4}]},{"speaker":"B","hanzi":"我中午十二点一刻吃饭。","pinyin":"Wǒ zhōngwǔ shí'èr diǎn yí kè chīfàn.","english":"I eat at a quarter past twelve.","units":[{"c":"我","p":"Wǒ","t":3},{"c":"中","p":"zhōng","t":1},{"c":"午","p":"wǔ","t":3},{"c":"十","p":"shí","t":2},{"c":"二","p":"èr","t":4},{"c":"点","p":"diǎn","t":3},{"c":"一","p":"yí","t":2},{"c":"刻","p":"kè","t":4},{"c":"吃","p":"chī","t":1},{"c":"饭","p":"fàn","t":4}]}]},{"id":"d_intro","title":"Introducing yourself","emoji":"🙋","lesson":"10.16","lines":[{"speaker":"A","hanzi":"你好！你叫什么名字？","pinyin":"Nǐ hǎo! Nǐ jiào shénme míngzi?","english":"Hello! What's your name?","units":[{"c":"你","p":"Nǐ","t":3},{"c":"好","p":"hǎo","t":3},{"c":"你","p":"Nǐ","t":3},{"c":"叫","p":"jiào","t":4},{"c":"什","p":"shén","t":2},{"c":"么","p":"me","t":5},{"c":"名","p":"míng","t":2},{"c":"字","p":"zi","t":5}]},{"speaker":"B","hanzi":"我叫罗斯。你呢？","pinyin":"Wǒ jiào Luósī. Nǐ ne?","english":"My name is Ross. And you?","units":[{"c":"我","p":"Wǒ","t":3},{"c":"叫","p":"jiào","t":4},{"c":"罗","p":"Luó","t":2},{"c":"斯","p":"sī","t":1},{"c":"你","p":"Nǐ","t":3},{"c":"呢","p":"ne","t":5}]},{"speaker":"A","hanzi":"我叫李明。你是哪国人？","pinyin":"Wǒ jiào Lǐ Míng. Nǐ shì nǎ guó rén?","english":"I'm Li Ming. Where are you from?","units":[{"c":"我","p":"Wǒ","t":3},{"c":"叫","p":"jiào","t":4},{"c":"李","p":"Lǐ","t":3},{"c":"明","p":"Míng","t":2},{"c":"你","p":"Nǐ","t":3},{"c":"是","p":"shì","t":4},{"c":"哪","p":"nǎ","t":3},{"c":"国","p":"guó","t":2},{"c":"人","p":"rén","t":2}]},{"speaker":"B","hanzi":"我是澳大利亚人。我是学生。","pinyin":"Wǒ shì Àodàlìyàrén. Wǒ shì xuéshēng.","english":"I'm Australian. I'm a student.","units":[{"c":"我","p":"Wǒ","t":3},{"c":"是","p":"shì","t":4},{"c":"澳","p":"Ào","t":4},{"c":"大","p":"dà","t":4},{"c":"利","p":"lì","t":4},{"c":"亚","p":"yà","t":4},{"c":"人","p":"rén","t":2},{"c":"我","p":"Wǒ","t":3},{"c":"是","p":"shì","t":4},{"c":"学","p":"xué","t":2},{"c":"生","p":"shēng","t":1}]},{"speaker":"A","hanzi":"很高兴认识你！","pinyin":"Hěn gāoxìng rènshi nǐ!","english":"Very nice to meet you!","units":[{"c":"很","p":"Hěn","t":3},{"c":"高","p":"gāo","t":1},{"c":"兴","p":"xìng","t":4},{"c":"认","p":"rèn","t":4},{"c":"识","p":"shi","t":5},{"c":"你","p":"nǐ","t":3}]},{"speaker":"B","hanzi":"我也很高兴认识你。","pinyin":"Wǒ yě hěn gāoxìng rènshi nǐ.","english":"Nice to meet you too.","units":[{"c":"我","p":"Wǒ","t":3},{"c":"也","p":"yě","t":3},{"c":"很","p":"hěn","t":3},{"c":"高","p":"gāo","t":1},{"c":"兴","p":"xìng","t":4},{"c":"认","p":"rèn","t":4},{"c":"识","p":"shi","t":5},{"c":"你","p":"nǐ","t":3}]}]}]